<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.slyvan25.OpenGHub</id>
  <name>OpenGHub</name>
  <summary>Logitech G HUB for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.slyvan25">
    <name>Silvan Paul</name>
  </developer>
  <description>
    <p>
      OpenGHub configures Logitech gaming peripherals over HID++ 2.0, in the interface G HUB
      users know: DPI and polling rate, LIGHTSYNC lighting with screen and audio effects,
      button assignments and macros written to on-board memory, per-game profiles, community
      profiles, Lua scripting and firmware updates.
    </p>
    <p>
      Racing wheels get operating range, centering spring, pedal curves, a userspace
      force-feedback driver and a gamepad mode for games without wheel support.
    </p>
    <p>OpenGHub is not affiliated with or endorsed by Logitech.</p>
  </description>
  <launchable type="desktop-id">io.github.slyvan25.OpenGHub.desktop</launchable>
  <url type="homepage">https://github.com/Slyvan25/OpenGHub</url>
  <url type="bugtracker">https://github.com/Slyvan25/OpenGHub/issues</url>
  <categories>
    <category>Utility</category>
    <category>Settings</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#d8e6f2</color>
    <color type="primary" scheme_preference="dark">#12161c</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Slyvan25/OpenGHub/master/docs/screenshots/devices.png</image>
      <caption>The connected devices, with battery and lighting</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Slyvan25/OpenGHub/master/docs/screenshots/assignments.png</image>
      <caption>Button assignments, dragged onto the device's own render</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Slyvan25/OpenGHub/master/docs/screenshots/lighting.png</image>
      <caption>Per-zone LIGHTSYNC lighting</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Slyvan25/OpenGHub/master/docs/screenshots/wheel.png</image>
      <caption>A racing wheel: range, spring, force feedback and pedals</caption>
    </screenshot>
  </screenshots>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">1040</display_length>
  </requires>
  <releases>
    <release version="0.1.0" date="2026-09-22"/>
  </releases>
</component>
