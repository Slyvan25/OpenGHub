# OpenGHub as a systemd user service — an alternative to the freedesktop
# autostart entry that Settings → General → Launch at startup writes.
#
#   systemctl --user enable --now openghub
#
# It restarts the app if it crashes and keeps its log in `journalctl --user -u
# openghub`. Turn "Launch at startup" off in the app first: the unit refuses to
# start while ~/.config/autostart/openghub.desktop exists, since two instances
# would fight over the devices.

[Unit]
Description=OpenGHub — Logitech G device configuration
Documentation=https://github.com/Slyvan25/OpenGHub
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=!%h/.config/autostart/openghub.desktop

[Service]
Type=simple
ExecStart=/usr/bin/openghub --minimized
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
